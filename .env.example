# Supabase credentials.
#
# Copy this file to `.env` (which is gitignored) and fill in the real values
# from your Supabase project: https://supabase.com/dashboard/project/_/settings/api
#
# Both of these are SAFE to expose to the client — the anon key is designed to
# be public, and Row Level Security policies in the database enforce that one
# user can never read or modify another user's rows. The thing you must NEVER
# put in client code is the `service_role` key (also on that settings page,
# marked "secret"), which bypasses RLS.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-jwt-here...
